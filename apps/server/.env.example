PORT=3000
DB_PATH=./storage/app.db
APP_SECRET=please-change-me

# Real-time news source mode: real | mock
NEWS_PROVIDER=real

# Existing news APIs
GNEWS_API_KEY=
NEWSAPI_KEY=

# New providers mentioned by the user
JUHE_API_KEY=
JUHE_NEWS_API_URL=http://v.juhe.cn/toutiao/index

ALAPI_TOKEN=
ALAPI_TOUTIAO_URL=https://v3.alapi.cn/api/new/toutiao

NEWSDATA_API_KEY=
NEWSDATA_API_URL=https://newsdata.io/api/1/latest

THE_NEWS_API_TOKEN=
THE_NEWS_API_URL=https://api.thenewsapi.com/v1/news/top

# 60s API fallback, no key required
SIXTY_SECONDS_API_URL=https://60s.viki.moe/v2/60s
SIXTY_SECONDS_STATIC_URL=https://60s-static.viki.moe

# Google News RSS locale
GOOGLE_NEWS_LANGUAGE=zh-CN
GOOGLE_NEWS_REGION=CN
GOOGLE_NEWS_CEID=CN:zh-Hans

# Optional partner/custom source endpoints
SOURCE_URL_TOUTIAO=
SOURCE_TOKEN_TOUTIAO=
SOURCE_AUTH_HEADER_TOUTIAO=Authorization

SOURCE_URL_WEIBO=
SOURCE_TOKEN_WEIBO=
SOURCE_AUTH_HEADER_WEIBO=Authorization

SOURCE_URL_WEIXIN=
SOURCE_TOKEN_WEIXIN=
SOURCE_AUTH_HEADER_WEIXIN=Authorization

# Qwen / DashScope AI generation
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-32b

